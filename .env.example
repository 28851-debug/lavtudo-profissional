# Credenciais usadas somente no servidor. Nunca use o prefixo VITE_ nestas chaves.
LAVTUDO_ADMIN_USER=admin
LAVTUDO_ADMIN_PASSWORD=admin
LAVTUDO_SESSION_SECRET=gere-uma-chave-aleatoria-longa

# O código possui valores publishable padrão para o projeto Supabase conectado.
